# shellcheck disable=SC2034,SC2128,SC2155,SC2206,SC2296,SC2298

# locale settings {{{
export LANG=en_US.UTF-8
export LANGUAGE=en_US
export LC_COLLATE=C
export LC_MONETARY=ja_JP.UTF-8
# }}}

# use emacs-like key bindings
bindkey -e

# utility functions {{{
fpath=(~/.zsh/functions $fpath)
autoload -Uz ~/.zsh/functions/*(:t)
__prepend_path() {
	# shellcheck disable=SC1036
	[[ ${path[(i)$1]} -gt ${#path} ]] && path=($1(N-/) $path)
}
__is_macos() {
	[[ $OSTYPE = darwin* ]]
}
# }}}

# load platform specific variables {{{
if __is_macos; then
	# shellcheck source=platforms/darwin.zsh
	. ~/.zsh/platforms/darwin.zsh
else
	# shellcheck source=platforms/linux.zsh
	. ~/.zsh/platforms/linux.zsh
fi
# }}}

# general settings {{{
# make '/' as word seperator
autoload -Uz select-word-style && select-word-style bash

# key bindings
bindkey "^U" backward-kill-line

# seealso: zshoptions(1)
# Changing Directories
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups

# Completion
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit && compinit

# Expansion and Globbing
setopt no_nomatch # suppress `zsh: no matches found`

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=50000
HISTORY_IGNORE='((l[als]|lla|popd)|(cd|l[als]|lla|man|scp|sftp|ssh|sudo|sudoedit|rm) *)'
zshaddhistory() {
	local cmd=(${(z)1})
	local j=1
	# skip all env vars
	while [[ ${cmd[$j]} = *=* ]]; do
		((j++))
	done
	whence "${cmd[$j]}" >|/dev/null || return 1
}
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_no_store
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt share_history

# Input/Output
setopt correct

# Prompting
setopt transient_rprompt
autoload -Uz promptinit && promptinit
prompt mytheme

# Zle
setopt no_beep
# }}}

# PATH setting {{{
__prepend_path ~/.local/bin

# flutter
__prepend_path ~/.local/flutter/default/bin

# texlive
if __is_macos; then
	__prepend_path ~/.local/texlive/default/bin/universal-darwin
else
	__prepend_path ~/.local/texlive/default/bin/x86_64-linux
fi

# golang
whence go >|/dev/null && __prepend_path "$(go env GOBIN)"
# }}}

# aliases {{{
alias ls='ls -h --color=auto'
alias la='ls -A'
alias ll='ls -l'
alias lla='ls -lA'

alias diff='diff --color=auto'
alias grep='grep --color=auto'

# copy-on-write
if __is_macos; then
	alias cp='cp -c'
else
	alias cp='cp --reflink=auto'
fi

alias mkdir='mkdir -p'

# prefer libarchive's tar because it supports more formats than GNU's one.
whence bsdtar >|/dev/null && alias tar='bsdtar'

whence nvim >|/dev/null && alias v='nvim'
# }}}

# environment variables {{{
# man(1)
export MANROFFOPT=-c
if whence nvim >|/dev/null; then
	export MANPAGER='nvim +Man!'
elif whence vim >|/dev/null; then
	export MANPAGER='vim +MANPAGER --not-a-term - -c "set nolist" -c "map q :<Cmd>q<CR>"'
fi

# less(1)
export LESS='-iFR -Dd+c -Du+gd -Dsybd'
export LESSHISTFILE=- # disable history

# GPG
if whence gpg >|/dev/null; then
	export GPG_TTY=$(tty)
	gpg-connect-agent updatestartuptty /bye >/dev/null
fi
if [[ -z $SSH_TTY ]] || [[ -z $SSH_AUTH_SOCK ]]; then
	if __is_macos; then
		# macOS App Store
		sshsock=~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
	else
		# Flatpak
		sshsock=~/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock
	fi
	if [[ ! -S $sshsock ]]; then
		# Native
		sshsock=~/.bitwarden-ssh-agent.sock
	fi
	if [[ -S $sshsock ]]; then
		export SSH_AUTH_SOCK=$sshsock
	elif [[ -n $GPG_TTY ]]; then
		export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
	fi
	unset sshsock
fi
# }}}

# syntax highlight {{{
if [[ -n $SYNTAX_HIGHLIGHT_SRC ]] && [[ -r $SYNTAX_HIGHLIGHT_SRC ]]; then
	# shellcheck disable=SC1090
	. "$SYNTAX_HIGHLIGHT_SRC"
	typeset -A ZSH_HIGHLIGHT_STYLES
	ZSH_HIGHLIGHT_STYLES[globbing]='none'
	ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
fi
# }}}

# unset utility functions {{{
unset -f __prepend_path
unset -f __is_macos
unload_variables
# }}}
