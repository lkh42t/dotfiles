# shellcheck disable=SC2034,SC2128,SC2155,SC2206,SC2296,SC2298

# locale settings {{{
export LANG=en_US.UTF-8
export LANGUAGE=en_US
export LC_COLLATE=C
export LC_MONETARY=ja_JP.UTF-8
# }}}

# use emacs-like key bindings
bindkey -e

# utility functions {{{
__append_path() {
	# shellcheck disable=SC1036
	local dirs=($@(N-/))
	local d
	for d in $dirs; do
		path=(${path:#$d} $d)
	done
}
__prepend_path() {
	# shellcheck disable=SC1036
	local dirs=($@(N-/))
	local d
	for d in ${(aO)dirs}; do
		path=($d ${path:#$d})
	done
}
__prepend_fpath() {
	# shellcheck disable=SC1036
	local dirs=($@(N-/))
	local d
	for d in ${(aO)dirs}; do
		fpath=($d ${fpath:#$d})
	done
}
__is_macos() {
	[[ $OSTYPE = darwin* ]]
}
__prepend_fpath ~/.zsh/functions
autoload -Uz ~/.zsh/functions/*(:t)
# }}}

# homebrew configuration {{{
if __is_macos && [[ -d /opt/homebrew ]]; then
	if [[ -z $HOMEBREW_PREFIX ]]; then
		export HOMEBREW_PREFIX=/opt/homebrew
		export HOMEBREW_CELLAR=$HOMEBREW_PREFIX/Cellar
		export HOMEBREW_REPOSITORY=$HOMEBREW_PREFIX
	fi
	__prepend_path "$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin"
	__prepend_fpath "$HOMEBREW_PREFIX/share/zsh-completions" "$HOMEBREW_PREFIX/share/zsh/site-functions"
fi
# }}}

# general settings {{{
# make '/' as word seperator
autoload -Uz select-word-style && select-word-style bash

# key bindings
bindkey "^U" backward-kill-line

# seealso: zshoptions(1)
# Changing Directories
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups

# Completion
__prepend_fpath ~/.zsh/completions
autoload -Uz compinit && compinit

# Expansion and Globbing
setopt no_nomatch # suppress `zsh: no matches found`

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=50000
HISTORY_IGNORE='((l[als]|lla|popd)|(cd|l[als]|lla|man|scp|sftp|ssh|sudo|sudoedit|rm) *)'
zshaddhistory() {
	local cmd=(${(z)1})
	local j=1
	# skip all env vars
	while [[ ${cmd[$j]} = *=* ]]; do
		((j++))
	done
	whence "${cmd[$j]}" >/dev/null || return 1
}
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_no_store
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt share_history

# Input/Output
setopt correct

# Prompting
setopt transient_rprompt
autoload -Uz promptinit && promptinit
prompt mytheme

# Zle
setopt no_beep
# }}}

# PATH setting {{{
__prepend_path ~/.local/bin

# flutter
__prepend_path ~/.local/flutter/default/bin

# texlive
if __is_macos; then
	__prepend_path ~/.local/texlive/default/bin/universal-darwin
else
	__prepend_path ~/.local/texlive/default/bin/x86_64-linux
fi

# golang
whence go >/dev/null && __prepend_path "$(go env GOBIN)"

# Xcode Command Line Tools
if __is_macos; then
	__append_path /Library/Developer/CommandLineTools/usr/bin
fi
# }}}

# aliases {{{
alias ls='ls -h --color=auto'
alias la='ls -A'
alias ll='ls -l'
alias lla='ls -lA'

alias diff='diff --color=auto'
alias grep='grep --color=auto'

# copy-on-write
if __is_macos; then
	alias cp='cp -c'
else
	alias cp='cp --reflink=auto'
fi

alias mkdir='mkdir -p'

# prefer libarchive's tar because it supports more formats than GNU's one.
whence bsdtar >/dev/null && alias tar='bsdtar'

whence nvim >/dev/null && alias v='nvim'
# }}}

# environment variables {{{
# man(1)
export MANROFFOPT=-c
if whence nvim >/dev/null; then
	export MANPAGER='nvim +Man!'
elif whence vim >/dev/null; then
	export MANPAGER='vim +MANPAGER --not-a-term - -c "set nolist" -c "map q :<Cmd>q<CR>"'
fi

# less(1)
# shellcheck disable=SC2016
export LESS='-iFR -Dd+c$Du+G$Ds+by'
export LESSHISTFILE=- # disable history

# GPG
if whence gpg >/dev/null; then
	export GPG_TTY=$(tty)
	pgrep --quiet gpg-agent &>/dev/null && gpg-connect-agent updatestartuptty /bye >/dev/null
fi
if [[ -z $SSH_TTY ]] || [[ -z $SSH_AUTH_SOCK ]]; then
	if __is_macos; then
		# macOS App Store
		sshsock=~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
	else
		# Flatpak
		sshsock=~/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock
	fi
	if [[ ! -S $sshsock ]]; then
		# Native
		sshsock=~/.bitwarden-ssh-agent.sock
	fi
	if [[ -S $sshsock ]]; then
		export SSH_AUTH_SOCK=$sshsock
	elif [[ -n $GPG_TTY ]]; then
		export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
	fi
	unset sshsock
fi
# }}}

# syntax highlight {{{
case $OSTYPE in
darwin*)
	zsh_highlight_src=$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
	;;
linux*)
	if [[ -f /etc/debian_version ]]; then
		# Debian
		zsh_highlight_src=/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
	else
		# Arch Linux
		zsh_highlight_src=/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
	fi
	;;
esac
if [[ -n $zsh_highlight_src ]] && [[ -r $zsh_highlight_src ]]; then
	# shellcheck disable=SC1090
	. "$zsh_highlight_src"
	typeset -A ZSH_HIGHLIGHT_STYLES
	ZSH_HIGHLIGHT_STYLES[globbing]='none'
	ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
fi
unset zsh_highlight_src
# }}}

# unset utility functions {{{
unset -f __append_path
unset -f __prepend_path
unset -f __prepend_fpath
unset -f __is_macos
# }}}
